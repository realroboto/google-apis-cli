        "https://www.googleapis.com/auth/webmasters": {
          "description": "View and manage Search Console data for your verified sites"
        }
      }
    }
  },
  "version": "v1",
  "basePath": "",
  "discoveryVersion": "v1",
  "schemas": {},
  "parameters": {
    "fields": {
