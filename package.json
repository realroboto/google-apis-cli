{
  "name": "google-apis-cli",
  "version": "0.3.0",
  "description": "One discovery-driven CLI (gapi) for 47 Google marketing and data APIs: Ads, GA4, Search Console, Tag Manager, Indexing, Merchant, Business Profile, SA360, CM360, DV360, YouTube, PageSpeed, CrUX, Sheets, Places and more. One login, read+write.",
  "type": "module",
  "bin": {
    "gapi": "dist/bin/gapi.js"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "discovery:check": "node scripts/discovery-check.ts",
    "gen:skill": "node scripts/gen-skill.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm discovery:check && pnpm build"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "google",
    "google-ads",
    "gtm",
    "tag-manager",
    "ga4",
    "analytics",
    "search-console",
    "indexing",
    "merchant-api",
    "business-profile",
    "search-ads-360",
    "campaign-manager-360",
    "display-video-360",
    "youtube",
    "pagespeed",
    "crux",
    "bigquery-data-transfer",
    "sheets",
    "places",
    "web-risk",
    "discovery",
    "cli"
  ],
  "homepage": "https://github.com/realroboto/google-apis-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realroboto/google-apis-cli.git"
  },
  "bugs": {
    "url": "https://github.com/realroboto/google-apis-cli/issues"
  },
  "dependencies": {
    "google-auth-library": "^11.3.3"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
