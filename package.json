{
  "name": "google-apis-cli",
  "version": "0.1.0",
  "description": "One discovery-driven CLI (gapi) for 47 Google marketing and data APIs: Ads, GA4, Search Console, Tag Manager, Indexing, Merchant, Business Profile, SA360, CM360, DV360, YouTube, PageSpeed, CrUX, Sheets, Places and more. One login, read+write.",
  "type": "module",
  "bin": {
    "gapi": "dist/bin/gapi.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "discovery:check": "node scripts/discovery-check.ts",
    "gen:skill": "node scripts/gen-skill.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "google",
    "google-ads",
    "gtm",
    "tag-manager",
    "ga4",
    "analytics",
    "search-console",
    "indexing",
    "merchant-api",
    "business-profile",
    "search-ads-360",
    "campaign-manager-360",
    "display-video-360",
    "youtube",
    "pagespeed",
    "crux",
    "bigquery-data-transfer",
    "sheets",
    "places",
    "web-risk",
    "discovery",
    "cli"
  ],
  "homepage": "https://github.com/realroboto/google-apis-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realroboto/google-apis-cli.git"
  },
  "bugs": {
    "url": "https://github.com/realroboto/google-apis-cli/issues"
  },
  "dependencies": {
    "google-auth-library": "^11.3.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9"
}
