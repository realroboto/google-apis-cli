{
  "name": "google-apis-cli",
  "version": "0.4.1",
  "description": "One discovery-driven CLI (gapi) for 49 Google marketing and data APIs: Ads, GA4, Search Console, Tag Manager, Indexing, Merchant, Business Profile, SA360, CM360, DV360, YouTube, PageSpeed, CrUX, BigQuery, Sheets, Places and more. One login, read+write.",
  "type": "module",
  "bin": {
    "gapi": "dist/bin/gapi.js"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "discovery:check": "node scripts/discovery-check.ts",
    "gen:skill": "node scripts/gen-skill.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm discovery:check && pnpm build"
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "google",
    "google-ads",
    "gtm",
    "tag-manager",
    "ga4",
    "analytics",
    "search-console",
    "indexing",
    "merchant-api",
    "business-profile",
    "search-ads-360",
    "campaign-manager-360",
    "display-video-360",
    "youtube",
    "pagespeed",
    "crux",
    "bigquery-data-transfer",
    "sheets",
    "places",
    "web-risk",
    "discovery",
    "cli"
  ],
  "homepage": "https://github.com/realroboto/google-apis-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/realroboto/google-apis-cli.git"
  },
  "bugs": {
    "url": "https://github.com/realroboto/google-apis-cli/issues"
  },
  "dependencies": {
    "google-auth-library": "^11.3.4"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
